{
  "name": "rockaden-wp",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter plugin dev",
    "typecheck": "pnpm --filter plugin typecheck",
    "lint": "pnpm --filter plugin lint:js",
    "check": "pnpm typecheck && pnpm lint && pnpm run lint:php && pnpm build",
    "package": "pnpm build && node scripts/package.mjs",
    "lint:php": "composer -d plugin lint:php && composer -d theme lint:php"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@msvens/schack-se-sdk",
      "@parcel/watcher",
      "core-js",
      "core-js-pure",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
